{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./.webpack/server",
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "src/server.ts",
    "src/main/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/renderer/**",
    "src/preload.ts"
  ]
}
